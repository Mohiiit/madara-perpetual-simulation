{
  "name": "izanagi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Izanagi: high-traffic Madara devnet simulation harness for Starknet Perpetual",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
